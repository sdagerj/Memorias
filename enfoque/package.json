{
  "name": "enfoque",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Enfoque — entrenamiento cognitivo dirigido. Uso personal, sin nube.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
