# Copia este archivo a .env y ajusta los valores

# Base de datos
# SQLite (desarrollo — sin instalación extra):
DATABASE_URL=sqlite+aiosqlite:///./pesodolar.db

# PostgreSQL (producción):
# DATABASE_URL=postgresql+asyncpg://pesodolar:password@localhost:5432/pesodolar

# Tasas de referencia (actualizar manualmente cuando BanRep cambia)
BANREP_RATE=8.75
IBR_OVERNIGHT=8.62

# TRM de cierre diciembre del año anterior (para cálculo YTD)
TRM_DIC_2025=4386.12

# Horario de ingesta diaria (hora Colombia UTC-5)
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=30

# CORS — orígenes permitidos del frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
